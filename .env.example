# --- PostgreSQL (docker compose and the API read the same variables) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jungle_wagering
DB_USER=jungle
DB_PASSWORD=change_me
# Separate database used only by the integration tests (never the dev one).
DB_NAME_TEST=jungle_wagering_test
# Connection pool size (integration tests need >= 10 for real parallelism).
DB_POOL_MAX=20
# SET LOCAL lock_timeout applied to every financial transaction, in ms.
LOCK_TIMEOUT_MS=5000

# --- HTTP ---
PORT=3000

# --- SQS (LocalStack). Fictitious credentials, LocalStack accepts anything ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
# FIFO queue receiving the integration events published from the outbox.
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
# Receives before SQS moves a message to the DLQ (redrive policy).
SQS_MAX_RECEIVE_COUNT=5

# --- Pending references (REFUND/ROLLBACK/WIN/LOSS that arrived before their BET) ---
# Delay before the first re-resolution attempt; doubles each attempt up to the ceiling.
PENDING_REFERENCE_INITIAL_BACKOFF_MS=1000
PENDING_REFERENCE_MAX_BACKOFF_MS=60000
# A pending transaction is rejected (REFERENCE_NOT_FOUND) when EITHER limit is reached.
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_MS=900000

# --- Health / SQS client ---
# Timeout of each readiness probe (PostgreSQL select 1, SQS GetQueueAttributes).
READINESS_TIMEOUT_MS=2000
SQS_REQUEST_TIMEOUT_MS=2000
# Optional: skip the GetQueueUrl lookup of the main queue.
# SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo

# --- Background work of each instance (default: enabled outside NODE_ENV=test) ---
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
PENDING_WORKER_ENABLED=true

# SQS consumer: messages processed at once, long-poll wait (0..20 s, also the
# worst-case shutdown latency), retry backoff = base * 2^(receives-1) capped at max.
SQS_CONSUMER_CONCURRENCY=10
SQS_WAIT_TIME_SECONDS=5
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=60

# Outbox publisher: idle poll interval, rows per transaction, failure backoff (ms),
# how often the lag/pending gauges are refreshed.
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000
OUTBOX_GAUGE_INTERVAL_MS=2000

# Pending-reference worker: poll interval, due rows per cycle, parallel resolutions.
PENDING_WORKER_INTERVAL_MS=1000
PENDING_WORKER_BATCH_SIZE=50
PENDING_WORKER_CONCURRENCY=5

# --- Logging ---
# pino level: fatal|error|warn|info|debug|trace|silent (silent under NODE_ENV=test).
LOG_LEVEL=info
