{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src test",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:e2e": "bun test test/e2e --timeout 60000",
    "test:resilience": "bun test test/resilience --timeout 240000",
    "test:load": "bun scripts/load-test.ts",
    "test:watch": "bun test --watch src",
    "migration:create": "bun scripts/migrate.ts create",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:status": "bun scripts/migrate.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/decorators": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.7",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@oxc-node/core": "^1.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
